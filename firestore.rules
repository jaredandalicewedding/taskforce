rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['jaredkokjinci3@gmail.com','acheung05@qub.ac.uk'];
    }
    match /plan/{doc}    { allow read: if true; allow write: if isEditor(); }
    match /seating/{doc} { allow read: if true; allow write: if isEditor(); }
  }
}
